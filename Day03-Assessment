package assessment;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class day3testcase02 {

	public static void main(String[] args) throws InterruptedException {
		//launch the browser
		WebDriver driver = new ChromeDriver();
		// maximize
		driver.manage().window().maximize();
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
		driver.get("https://demoapps.qspiders.com/ui/datePick?sublist=0");
		Thread.sleep(2000);
		driver.findElement(By.cssSelector("[type='text']")).click();
		driver.findElement(By.xpath("//button[@class='react-datepicker__navigation react-datepicker__navigation--next']")).click();
		Thread.sleep(1000);
		driver.findElement(By.xpath("//div[@class='react-datepicker__day react-datepicker__day--020']")).click();
		Thread.sleep(1000);
		WebElement date = driver.findElement(By.xpath("//input[@placeholder='Select A Date' and @type='text']"));
		if(date.getDomProperty("value").equals("20/10/2026"))
		{
			System.out.println("selected date is displayed");
		}
		else
		{
			System.out.println("selected date is not displayed");
		}
		Thread.sleep(1000);
		driver.quit();

	}

}
